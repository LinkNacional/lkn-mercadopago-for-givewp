#: Public/LknmpGatewayGiveWPGateway.php:191
#: Public/LknmpGatewayGiveWPPublic.php:105
msgid "The Name field is empty. Please fill in this field before proceeding."
msgstr ""
"O campo Nome está vazio. Por favor, preencha este campo antes de prosseguir."

#: Public/LknmpGatewayGiveWPGateway.php:192
#: Public/LknmpGatewayGiveWPPublic.php:106
msgid "The Name field must be at least 3 letters."
msgstr "O campo Nome deve ter no mínimo 3 letras."

#: Public/LknmpGatewayGiveWPGateway.php:193
msgid ""
"The Last Name field is empty. Please fill in this field before proceeding."
msgstr ""
"O campo Sobrenome está vazio. Por favor, preencha este campo antes de "
"prosseguir."

#: Public/LknmpGatewayGiveWPGateway.php:194
msgid "The Last Name field must be at least 3 letters."
msgstr "O campo Sobrenome deve ter no mínimo 3 letras."

#: Public/LknmpGatewayGiveWPGateway.php:195
#: Public/LknmpGatewayGiveWPPublic.php:107
msgid "The Email field is empty. Please fill in this field before proceeding."
msgstr ""
"O campo Email está vazio. Por favor, preencha este campo antes de prosseguir."

#: Public/LknmpGatewayGiveWPGateway.php:196
#: Public/LknmpGatewayGiveWPPublic.php:108
msgid "The Email field is invalid. Please enter a valid email address."
msgstr ""
"O campo Email está inválido. Por favor, insira um endereço de email válido."

